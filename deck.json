      "topic": "Physics",
      "q": "A current of {I} A flows through a {R} Ω resistor. What is the potential difference across it?",
      "vars": { "I": { "min": 0.5, "max": 5, "step": 0.5 }, "R": { "min": 2, "max": 50, "step": 2 } },
      "answer": "I * R", "unit": "V", "dp": 1,
      "wrong": ["R / I", "I / R", "I * R * 2"],
