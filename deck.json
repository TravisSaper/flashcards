      "id": "phys-weight-mass",
      "topic": "Physics",
      "q": "An object weighs {W} N on Earth. Find its mass. (g = 9.8 N/kg)",
      "vars": { "W": { "min": 50, "max": 500, "step": 10 } },
      "answer": "W / 9.8", "unit": "kg", "dp": 1,
      "wrong": ["W * 9.8", "W / 9.8 * 2", "W"],
      "explain": "W = mg, so m = W / g = {W} / 9.8"
